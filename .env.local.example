# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit it.

# Supabase project settings — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web push public key (M5) — from `npx web-push generate-vapid-keys`.
# Only the PUBLIC key goes here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Android server push via Firebase Cloud Messaging (optional, M7).
# Set to true only after android/app/google-services.json is in place —
# without it, FCM registration would crash the APK.
NEXT_PUBLIC_FCM_ENABLED=false

# NOT client vars — these live in Supabase Edge Function secrets, not here:
#   VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT
#   CRON_SECRET
#   FCM_SERVICE_ACCOUNT (optional)
#   SUPABASE_SERVICE_ROLE_KEY is injected automatically.
